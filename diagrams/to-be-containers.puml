@startuml
!include <C4/C4_Container>

title Тёплый дом — целевая микросервисная архитектура (To-Be)

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

skinparam linetype polyline
skinparam nodesep 85
skinparam ranksep 110
skinparam ArrowFontSize 9
skinparam ArrowFontColor #333333
skinparam defaultFontName Arial

Person(user, "Пользователь", "Управляет домом, устройствами и сценариями")
System_Ext(devices, "Устройства умного дома", "Датчики, отопление, свет, ворота")

System_Boundary(system, "Экосистема «Тёплый дом»") {

    Container(web, "Web UI", "Веб-приложение", "Кабинет пользователя")

    Container(api, "API Gateway", "HTTPS / REST", "Единая точка входа")

    Container(identity, "Identity Service", "REST API", "Учётные записи и доступ")

    Container(home, "Home Service", "REST API", "Дома и права доступа")

    Container(device, "Device Service", "REST API", "Регистрация и управление устройствами")

    Container(telemetry, "Telemetry Service", "REST API", "Измерения и история")

    Container(automation, "Automation Service", "REST API", "Правила и сценарии")

    Container(iot, "IoT Gateway", "MQTT / HTTP", "Адаптеры протоколов и обмен с оборудованием")

    ContainerQueue(bus, "Message Broker", "RabbitMQ", "События устройств и измерений")

    ContainerDb(identityDb, "Identity DB", "PostgreSQL", "Пользователи")

    ContainerDb(homeDb, "Home DB", "PostgreSQL", "Дома и доступ")

    ContainerDb(deviceDb, "Device DB", "PostgreSQL", "Устройства")

    ContainerDb(telemetryDb, "Telemetry DB", "PostgreSQL", "Измерения")

    ContainerDb(automationDb, "Automation DB", "PostgreSQL", "Сценарии")
}

' =====================================================
' 1. Пользовательские запросы
' =====================================================

Rel_D(user, web, "Работает в кабинете", "HTTPS")

Rel_D(web, api, "Запросы", "HTTPS / JSON")

Rel_D(api, identity, "Авторизация", "REST")

Rel_D(api, home, "Управление домами", "REST")

Rel_D(api, device, "Устройства и команды", "REST")

Rel_D(api, telemetry, "Просмотр измерений", "REST")

Rel_D(api, automation, "Настройка сценариев", "REST")


' =====================================================
' 2. Собственные базы данных микросервисов
' =====================================================

Rel_D(identity, identityDb, "Чтение / запись", "SQL")

Rel_D(home, homeDb, "Чтение / запись", "SQL")

Rel_D(device, deviceDb, "Чтение / запись", "SQL")

Rel_D(telemetry, telemetryDb, "Чтение / запись", "SQL")

Rel_D(automation, automationDb, "Чтение / запись", "SQL")


' =====================================================
' 3. Взаимодействие с физическими устройствами
' =====================================================

Rel_D(device, iot, "Команды устройствам", "REST / очередь")

Rel_U(devices, iot, "Показания и состояния", "MQTT / HTTP")


' =====================================================
' 4. Асинхронное взаимодействие через RabbitMQ
' =====================================================

Rel_D(iot, bus, "Публикует телеметрию", "AMQP")

Rel_L(bus, telemetry, "События измерений", "AMQP")

Rel_L(bus, automation, "Триггеры сценариев", "AMQP")

Rel_U(automation, device, "Запускает команды", "REST")


' =====================================================
' 5. Управление расположением элементов
' =====================================================

' Микросервисы в горизонтальном ряду

Lay_R(identity, home)

Lay_R(home, device)

Lay_R(device, telemetry)

Lay_R(telemetry, automation)


' IoT Gateway и брокер сообщений

Lay_D(device, iot)

Lay_R(iot, bus)


' Базы данных под соответствующими микросервисами

Lay_D(identity, identityDb)

Lay_D(home, homeDb)

Lay_D(device, deviceDb)

Lay_D(telemetry, telemetryDb)

Lay_D(automation, automationDb)

@enduml